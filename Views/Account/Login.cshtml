@model LoginViewModel
@{
    ViewData["Title"] = "Staff Login - Paws Home Portal";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 rounded-4 shadow-md bg-white overflow-hidden">
            <!-- Header Banner -->
            <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #064e3b 0%, #059669 100%);">
                <div class="fs-1 mb-1">🐾</div>
                <h4 class="fw-bold mb-0">Shelter Staff Portal</h4>
                <p class="text-white-50 small mb-0">Secure login for shelter administrators</p>
            </div>

            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold small">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person-fill"></i></span>
                            <input asp-for="Username" class="form-control border-start-0" placeholder="admin" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg rounded-pill w-100 mb-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Staff Dashboard
                    </button>
                </form>

                <!-- One-click Demo Helper for Presentation/Viva -->
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="small fw-bold text-dark mb-1">
                        <i class="bi bi-mortarboard-fill text-success me-1"></i> Academic Viva / Demo Credentials
                    </div>
                    <div class="small text-muted mb-2">Username: <code>admin</code> &bull; Password: <code>admin123</code></div>
                    <button type="button" id="fillDemoCredsBtn" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                        <i class="bi bi-lightning-fill text-warning"></i> Auto-Fill Demo Credentials
                    </button>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                <i class="bi bi-arrow-left"></i> Return to Public Adoption Portal
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
