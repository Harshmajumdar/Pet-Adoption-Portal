@model IEnumerable<Pet>
@{
    ViewData["Title"] = "My Shortlist - Favorite Pets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            My Shortlist <i class="bi bi-heart-fill text-danger"></i>
        </h2>
        <p class="text-muted mb-0">
            Pets you marked as favourite are remembered for your current browser session (no account required).
        </p>
    </div>

    @if (Model.Any())
    {
        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
            @Model.Count() @(Model.Count() == 1 ? "Pet Shortlisted" : "Pets Shortlisted")
        </span>
    }
</div>

@if (Model.Any())
{
    <div class="row g-4 mb-4">
        @foreach (var pet in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <partial name="_PetCard" model="pet" />
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white my-4">
        <div class="fs-1 mb-2">🐾</div>
        <h4 class="fw-bold text-muted mb-2">Your Shortlist is Empty</h4>
        <p class="text-muted" style="max-width: 460px; margin: 0 auto 1.5rem auto;">
            Browse our gallery of rescues and click the heart icon on any pet card to add them to your shortlist.
        </p>
        <div>
            <a class="btn btn-success rounded-pill px-4 py-2" asp-controller="Pets" asp-action="Index">
                <i class="bi bi-search me-1"></i> Browse Pets Now
            </a>
        </div>
    </div>
}
