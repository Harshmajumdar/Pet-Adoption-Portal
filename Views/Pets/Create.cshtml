@model Pet
@{
    ViewData["Title"] = "Add New Pet";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left"></i> Back to gallery
            </a>
            <span class="text-muted">&bull;</span>
            <span class="small text-muted">Shelter Management</span>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
            <h3 class="fw-bold mb-1">
                <i class="bi bi-plus-circle text-success me-2"></i>Register New Rescue Pet
            </h3>
            <p class="text-muted small mb-4">Add animal details and photo URL to make them available for public adoption.</p>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 p-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold small">Pet Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Bella, Bruno" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Species" class="form-label fw-bold small">Species</label>
                        <select asp-for="Species" class="form-select" asp-items="@(new SelectList(PetOptions.Species))">
                            <option value="">-- Choose Species --</option>
                        </select>
                        <span asp-validation-for="Species" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Gender" class="form-label fw-bold small">Gender</label>
                        <select asp-for="Gender" class="form-select" asp-items="@(new SelectList(PetOptions.Genders))">
                            <option value="">-- Choose Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Breed" class="form-label fw-bold small">Breed</label>
                        <input asp-for="Breed" class="form-control" placeholder="e.g. Golden Retriever, Persian Cat" />
                        <span asp-validation-for="Breed" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6 mb-3">
                        <label asp-for="AgeInMonths" class="form-label fw-bold small">Age (in Months)</label>
                        <input asp-for="AgeInMonths" type="number" class="form-control" placeholder="e.g. 12 (1 year)" />
                        <span asp-validation-for="AgeInMonths" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold small">Pet Story &amp; Personality</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Friendly, vaccinated, good with children, loves fetch..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-bold small">Photo Web URL (High Quality)</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                    <div class="form-text small">Enter any online image link (e.g. Unsplash photo URL). If left blank, a species emoji will be displayed.</div>
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-4">
                        <i class="bi bi-check-lg me-1"></i> Save &amp; Publish Pet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
