@model Pet
@{
    ViewData["Title"] = $"{Model.Name} - Details & Care Records";
    var isStaff = !string.IsNullOrEmpty(Context.Session.GetString("AdminName"));
    var shortlist = Context.Session.GetObject<List<int>>("Shortlist") ?? new List<int>();
    var inShortlist = shortlist.Contains(Model.Id);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var isAvailable = Model.Status == PetStatus.Available;
}

<!-- Breadcrumb Navigation -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Pets" asp-action="Index" class="text-decoration-none">Find a Pet</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="row g-4 align-items-start mb-5">
    <!-- Left Column: Pet Showcase Image -->
    <div class="col-12 col-lg-5">
        <div class="position-relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="pet-details-hero-img" alt="@Model.Name" />
            }
            else
            {
                <div class="pet-emoji pet-emoji-big rounded-4 shadow-sm w-100 d-flex align-items-center justify-content-center bg-light">
                    @Model.Emoji
                </div>
            }

            <div class="position-absolute top-0 start-0 m-3">
                @if (isAvailable)
                {
                    <span class="badge bg-success fs-6 rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                        <span class="status-dot"></span> Available for Adoption
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6 rounded-pill px-3 py-2 shadow-sm">
                        <i class="bi bi-patch-check-fill"></i> @Model.Status
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Pet Story & Specifications -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h1 class="fw-bold display-6 mb-1">@Model.Name</h1>
                    <p class="text-muted fs-6 mb-0">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        @(string.IsNullOrWhiteSpace(Model.Breed) ? "Mixed Breed" : Model.Breed) &bull; Sanctuary Resident
                    </p>
                </div>
                <div class="fs-1 text-muted" title="@Model.Species">@Model.Emoji</div>
            </div>

            <hr class="my-3" />

            <!-- Key Specs Grid -->
            <div class="row g-2 mb-4">
                <div class="col-6 col-sm-3">
                    <div class="detail-spec-card">
                        <div class="spec-label">Species</div>
                        <p class="spec-val">@Model.Species</p>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="detail-spec-card">
                        <div class="spec-label">Gender</div>
                        <p class="spec-val">
                            @if (Model.Gender == "Male")
                            {
                                <span class="text-primary"><i class="bi bi-gender-male"></i> Male</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-gender-female"></i> Female</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="detail-spec-card">
                        <div class="spec-label">Age</div>
                        <p class="spec-val">@Model.AgeText</p>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="detail-spec-card">
                        <div class="spec-label">Intake Date</div>
                        <p class="spec-val" style="font-size: 0.95rem;">@Model.DateAdded.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
            </div>

            <!-- About / Personality Section -->
            <div class="mb-4">
                <h5 class="fw-bold mb-2"><i class="bi bi-chat-heart text-success me-2"></i>About @Model.Name</h5>
                <div class="p-3 bg-light rounded-3 text-secondary lh-base">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "A sweet and friendly pet looking for a caring, forever home." : Model.Description)
                </div>
            </div>

            <!-- Adoption Action Controls -->
            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                @if (isAvailable)
                {
                    <a class="btn btn-success btn-lg rounded-pill px-4 flex-grow-1 d-flex align-items-center justify-content-center gap-2" 
                       asp-controller="Applications" asp-action="Apply" asp-route-petId="@Model.Id">
                        <i class="bi bi-house-heart-fill"></i>
                        <span>Apply to Adopt @Model.Name</span>
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg rounded-pill px-4 flex-grow-1" disabled>
                        <i class="bi bi-lock-fill"></i> Currently Not Available
                    </button>
                }

                @if (inShortlist)
                {
                    <form asp-controller="Shortlist" asp-action="Remove" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-outline-danger btn-lg rounded-pill px-3" title="Remove from shortlist">
                            <i class="bi bi-heart-fill"></i> In Shortlist
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="Shortlist" asp-action="Add" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-outline-secondary btn-lg rounded-pill px-3" title="Add to shortlist">
                            <i class="bi bi-heart"></i> Shortlist
                        </button>
                    </form>
                }

                @if (isStaff)
                {
                    <div class="btn-group">
                        <a class="btn btn-outline-primary btn-lg rounded-pill px-3" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a class="btn btn-outline-dark btn-lg rounded-pill px-3" asp-action="Delete" asp-route-id="@Model.Id">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Care & Medical Records Card -->
<div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="bi bi-shield-check text-success me-2"></i>Medical &amp; Vaccination History
            </h4>
            <p class="text-muted small mb-0">
                Every animal at Paws Home receives verified preventive medical care and regular booster inoculations.
            </p>
        </div>

        @if (isStaff)
        {
            <a class="btn btn-sm btn-success rounded-pill px-3 d-flex align-items-center gap-1" 
               asp-controller="Vaccinations" asp-action="Create" asp-route-petId="@Model.Id">
                <i class="bi bi-plus-circle"></i>
                <span>Add Care Record</span>
            </a>
        }
    </div>

    <div class="care-timeline-table table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Treatment / Vaccine</th>
                    <th>Administration Date</th>
                    <th>Next Booster Due</th>
                    <th>Veterinary Notes</th>
                    @if (isStaff) { <th class="text-end">Staff Actions</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.VaccinationRecords.OrderByDescending(x => x.DateGiven))
                {
                    <tr>
                        <td class="fw-bold">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>
                            @v.VaccineName
                        </td>
                        <td>@v.DateGiven.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (v.NextDueDate == null)
                            {
                                <span class="text-muted small">Single dose / completed</span>
                            }
                            else
                            {
                                var isOverdue = v.NextDueDate.Value.Date < DateTime.Today;
                                var isDueSoon = !isOverdue && v.NextDueDate.Value.Date <= DateTime.Today.AddDays(30);

                                <span class="fw-semibold me-2">@v.NextDueDate.Value.ToString("dd MMM yyyy")</span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-exclamation-circle-fill me-1"></i> Overdue
                                    </span>
                                }
                                else if (isDueSoon)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-clock-history me-1"></i> Due Soon
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-check-lg me-1"></i> Protected
                                    </span>
                                }
                            }
                        </td>
                        <td class="text-muted small">
                            @(string.IsNullOrWhiteSpace(v.Notes) ? "-" : v.Notes)
                        </td>
                        @if (isStaff)
                        {
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary rounded-pill me-1" asp-controller="Vaccinations" asp-action="Edit" asp-route-id="@v.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Vaccinations" asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this care record?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.VaccinationRecords.Any())
                {
                    <tr>
                        <td colspan="@(isStaff ? 5 : 4)" class="text-center py-4 text-muted">
                            <i class="bi bi-clipboard-x fs-3 d-block mb-1"></i>
                            No medical records logged yet for this rescue.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mb-4">
    <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i> Back to all pets
    </a>
</div>
