@model IEnumerable<AdoptionApplication>
@{
    ViewData["Title"] = "Adoption Applications - Staff Review";
    var current = (string?)ViewBag.Status ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-clipboard2-check text-success me-2"></i>Adoption Applications
        </h2>
        <p class="text-muted mb-0">Shelter Staff Control Panel: Review candidate applications and approve adoptions.</p>
    </div>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    @foreach (var s in new[] { "", "Pending", "Approved", "Rejected" })
    {
        var label = s == "" ? "All Applications" : s;
        var icon = s switch
        {
            "Pending" => "bi-hourglass-split",
            "Approved" => "bi-check2-circle",
            "Rejected" => "bi-x-circle",
            _ => "bi-collection"
        };
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 @(current == s ? "active" : "bg-white border text-dark")" 
               asp-action="Index" asp-route-status="@s">
                <i class="bi @icon me-1"></i> @label
            </a>
        </li>
    }
</ul>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Pet Details</th>
                    <th>Applicant</th>
                    <th>Contact Info</th>
                    <th>Adoption Motivation</th>
                    <th>Date Applied</th>
                    <th>Current Status</th>
                    <th class="text-end pe-4">Shelter Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var badgeClass = a.Status switch
                    {
                        "Approved" => "bg-success-subtle text-success border border-success-subtle",
                        "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle",
                        _ => "bg-warning-subtle text-warning border border-warning-subtle"
                    };

                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(a.Pet?.ImageUrl))
                                {
                                    <img src="@a.Pet.ImageUrl" class="rounded-circle object-fit-cover shadow-xs" width="42" height="42" alt="@a.Pet?.Name" />
                                }
                                else
                                {
                                    <span class="fs-4">@a.Pet?.Emoji</span>
                                }
                                <div>
                                    <a asp-controller="Pets" asp-action="Details" asp-route-id="@a.PetId" class="fw-bold text-decoration-none text-dark">
                                        @a.Pet?.Name
                                    </a>
                                    <div class="small text-muted">@a.Pet?.Breed</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@a.ApplicantName</div>
                            <div class="small text-muted"><i class="bi bi-geo-alt"></i> @a.City</div>
                            @if (a.HasOtherPets)
                            {
                                <span class="badge bg-light text-secondary border rounded-pill small mt-1">Has Pets</span>
                            }
                        </td>
                        <td>
                            <div class="small"><i class="bi bi-envelope text-muted me-1"></i>@a.Email</div>
                            <div class="small"><i class="bi bi-telephone text-muted me-1"></i>@a.Phone</div>
                        </td>
                        <td style="max-width: 260px;">
                            <div class="small text-secondary lh-sm text-truncate" title="@a.Reason">
                                @a.Reason
                            </div>
                        </td>
                        <td>
                            <span class="small text-muted">@a.AppliedOn.ToString("dd MMM yyyy")</span>
                        </td>
                        <td>
                            <span class="badge @badgeClass rounded-pill px-3 py-1">@a.Status</span>
                        </td>
                        <td class="text-end pe-4">
                            @if (a.Status == ApplicationStatus.Pending)
                            {
                                <div class="btn-group">
                                    <form asp-action="Approve" asp-route-id="@a.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Approve adoption for @a.ApplicantName? This pet will be marked as Adopted and other pending requests will be closed.');">
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 me-1">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@a.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Reject this application?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-x-lg"></i> Reject
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="small text-muted">Processed</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            No applications found in this category.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
